/datum/vision_quest/abyssor_mutated
	name = "The Deepfather"
	description = "He calls out from depths, you answer."
	required_tier = 3
	possible_rewards = list(
		/obj/item/dream_material/dream_spike = "spikes",
		/obj/item/dream_material/dream_seed = "seeds",
		/obj/item/dream_material/parchment_raw = "parchment"
	)
	possible_bonus_rewards = list(
		/obj/item/dream_material/dream_spike = "spikes",
		/obj/item/dream_material/dream_seed = "seeds",
		/obj/item/dream_material/parchment_raw = "parchment"
	)
	target_description = "unknown"
	summary = "It cannot be."
	vision_text = "Darkness envelops me. \
	Walls rise up, I'm ever sinking deeper. A rounded pit ever sinking deeper into the abyss. \
	The light of the surface long gone. I'm alone, abandoned. \
	The writhing won't stop. A cloying shroud that presses in, tasting of iron and forgotten things. \
	I peer down, an undulating mass under my feet. \
	I have no feet, the creeping slime has enveloped them. It is just I, and the horror at the bottom of his great expanse. \
	Countless eyes like pearls, slide open from the uniform, writhing mass, surrounding me. \
	Tendrils caress my back, filling every pore with a suffocating intimacy. Crevices between the flesh I did not know to possess. \
	\n\nWhen the squirming darkness finally parts, a suffocating warmth settles. A red glow suffuses the void, whilst my footing is found upon a mighty, pulsating rock. \
	The realization hits. Abyssor? Is that you? \
	Mishapen, tumorous and decrepit. A form no longer bearing Psydon's grace. It matters naught. \
	He is a sleeping giant not at peace, but tormented by a fever-dream. The past distant, where he stood above the seas, as SYON approaches. \
	The fragment lies here now, an affliction. The flesh burns where it touches the stone, not just mine, but His just the same. \
	A challenge to overcome, we must be greater, for His struggle is the greatest."
	possible_phrases = list(
		"The deepfather is ill",
		"Abyssor requires your faith",
		"Some tumors are pure",
		"His sleep is pained"
	)
	valid_roles = list()
	// Any role is valid.

/datum/vision_quest/dreamfiends
	name = "The Dreameater"
	description = "It calls out from depths, you answer."
	required_tier = 3
	possible_rewards = list(
		/obj/item/dream_material/dream_spike = "spikes",
		/obj/item/dream_material/dream_seed = "seeds",
		/obj/item/dream_material/parchment_raw = "parchment"
	)
	possible_bonus_rewards = list(
		/obj/item/dream_material/dream_spike = "spikes",
		/obj/item/dream_material/dream_seed = "seeds",
		/obj/item/dream_material/parchment_raw = "parchment"
	)
	target_description = "unknown"
	summary = "There are foul beings in His realm."
	vision_text = "The chittering in the dark call out. \
	Strangely... Eloquent, as if it could deceive me, yet it knowns I'm already trapped. \
	Thin, spindly claws crawl across a web of strings, resembling anything but a spider. \
	No... I can see the vicious teeth of a lamprey's head instead. \
	Yet unlike most fiends, I do not feel the threat of it demanding my mind. To feast upon my dreams. \
	It whispers of desiring grander supper. It wishes for aspirations rather than mere, lowly dreams. \
	My very imagination, hope... In fact, I seem so, so very small in its eyeless gaze. \
	Mortals I shall bring, or I shall experience that very mortality that defines us. \
	Perhaps... Knowledge makes for a more enticing offer instead. I can hear its every thought, as if it cares not for what I perceive. \
	It hears whispers from every single soul that dreams of realms it considers its domain. \
	Teeth pinch the tether that connects me to His dream. Tugging on my string. \
	I'm merely a visitor, no, a guest in its realm. As it subjects me to yet more honeyed words. \
	Tales and promises, how it will watch over us like PSYDON once did. \
	No more suffering, simply peace and tranquility in an otherwise tumultuous time. \
	It is only the swirling mealstorm of the pool that whisks me away from the creature. \
	Abyssor brings my salvation. \
	May -IT- remain down there, for good."
	possible_phrases = list(
		"do not believe whispers of salvation",
		"dreamfiends eat more than dreams",
		"they are not all simple beasts",
		"naledi speaks of demons, the dream speaks of fiends"
	)
