/obj/item/reagent_containers/food/snacks/grown/rogue/blend
	icon = 'modular/Neu_Brews/icons/teablends.dmi'
	bitesize = 1
	list_reagents = list(/datum/reagent/consumable/nutriment = 2)
	rotprocess = null
	w_class = WEIGHT_CLASS_TINY

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/raneshenbitters
	name = "Blended Raneshen Bitter"
	desc = "Popular in Raneshani tea houses, this strong brew is best paired with a sweet treat to offset its bitterness."
	icon_state = "raneshenbitter"
	tastes = list("bitterness" = 1, "a mouthful of cough-inducing powderiness" = 1)

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/eoragrace
	name = "Blended Eora's Grace"
	desc = "Among the lesser known gifts of Eora is the humble jacksberry. Paired with marigold, another one of her blessings, this tea soothes the soul and heals the body. Add something sweet to complete her love…"
	icon_state = "eorasgracetea"
	tastes = list("dry, floral fruitiness" = 1)

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/eoralovefake
	name = "Blended Eora's Love"
	desc = "With a sweetener added, this drink becomes sickly sweet. Nobles of Azuria and southern Otavans sup from this in indolent, warm summer nights."
	icon_state = "eoraslovefake"
	tastes = list("dry, floral sweetness" = 1)

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/eoralove
	name = "Blended Eora's Love"
	desc = "Perform the rite. Calendula, for her protection. Jacksberry, for her nourishment. Honey, for her smile. This is the blend that made Ravox weep with affection."
	icon_state = "eoraslove"
	tastes = list("dry, floral sweetness" = 1)

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/ravoxcalm
	name = "Blended Ravox's Calm"
	desc = "Ravoxian Templars drink this on the dawn of a battle. It is said to clear and hone the mind - preparing them for battle and giving them the energy to fight."
	icon_state = "ravoxtea"
	tastes = list("caramely bitterness" = 1, "floral astringence" = 1)

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/mocha
	name = "Veranda Coffee Blend"
	desc = "Naledi call this 'Veranda', after the plains the coffee originated from. It is brewed by coffee houses, to invigorate discussion, by astronomers, to peer into the night, and the nomads, to drink together under the stars. The second most favourite drink of Naledi, behind Raki."
	icon_state = "mocha"
	tastes = list("chocolately bitterness" = 1)

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/gerevine
	name = "Blended Gerevine"
	desc = "The drink of homecoming, traditionally drunk by pilgrims to regain strength after returning to Otava. But it remains popular even then, spreading along pilgrimage routes."
	icon_state = "gerevine"
	tastes = list("floral fruitiness" = 1)

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/schorle
	name = "Apfelschorle Preparation"
	desc = "The Celestial Academy of Grenzelhoft is host to a large number of apple trees. In a dogged attempt to make students stop making it all into alcoholic cider, an alternative way was found to give juice its sparkling quality. This is what came out and summers have become so much nicer."
	icon_state = "schorle"
	tastes = list("prickling fruitiness" = 1)

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/baothablend
	name = "Void Blend"
	desc = "Perform the rite. Atropa, for her sickly sweet smile. Defiled lux, for her anguish of betrayal. This is the drink… Forget and sleep. Forget. Outrun your pain, if you dare."
	icon_state = "baothablend"
	tastes = list("sweet, sickly oblivion" = 1)

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/forgottenlove
	name = "The Sisters Blend"
	desc = "A union of love and pain. Eorans and Baothans both fear this brew, for it promises the impossible. Or does it? "
	icon_state = "forgottenlove"
	tastes = list("bitter, incomplete nostalgia" = 1)

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/chai
	name = "Chai Blend"
	desc = "A spiced tea blend from the eastern lands. Kazengun and Lingyue both claim they have created it, while some western scholars say it is from eastern Raneshen. True esoterics claim it was actually invented by a foolish snake."
	icon_state = "chai"
	tastes = list("bitterness" = 1, "a mouthful of cough-inducing powderiness" = 1)

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/volfmilk
	name = "Vargmjölk syrup"
	desc = "A sticky, sugary grit of chopped, dried and thickened blend of berries, predominantly the humble raspberry. Gronnites drink this in the cold nites of their homeland, to stay hardy and fend off the cold."
	icon_state = "volfmilk"
	tastes = list("syrupy fruitiness" = 1)

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/frukkte
	name = "Fruktte grains"
	desc = "Fjallites carve glacier ice to cool down in their surprisingly hot summers and prepare Fruktte - dried and chopped berries, which are then cooked down to a thick syrup, which is diluted with melting ice. Invigorating and fresh."
	icon_state = "fruktte"
	tastes = list("syrupy fruitiness" = 1)

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/barleytea
	name = "Prepared barley"
	desc = "Toasted grains of barley mixed with clippings of artemisia, as bittering herbs. Hammerhold dwarves swear by beers and ales, but they too recognize that sickness isn’t the time for drinking. So they simply made a substitute that keeps a dwarf sober."
	icon_state = "barleytea"
	tastes = list("astringent graininess" = 1)

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/kvass
	name = "Kvass Mixture"
	desc = "Originally just a way to keep bread from going stale a little bit longer, Kvass has become quite popular as summer (when cold) and winter (when warm) drink in Aavnr, making it synonymous with the steppes."
	icon_state = "kvass"
	tastes = list("fruity breadiness" = 1)

/obj/item/reagent_containers/food/snacks/grown/rogue/blend/avantare
	name = "Avantare Blend"
	desc = "Some ports make it illegal for sailors to not enter before they have consumed a quart of Avantare - a mixture of lemon juice and minthra, to fend off shipborne disease and bad breath."
	icon_state = "avantare"
	tastes = list("fresh sourness" = 1)
